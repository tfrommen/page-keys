#. Plugin Name of the plugin
#: page-keys.php
msgid "Page Keys"
msgstr "Page Keys"

#. Plugin URI of the plugin
#: page-keys.php
msgid "https://wordpress.org/plugins/page-keys/"
msgstr "https://de.wordpress.org/plugins/page-keys/"

#. Description of the plugin
#: page-keys.php
msgid "Register page keys, assign WordPress pages to them, and access each of these pages by its individual key."
msgstr "Registriere Seitenschlüssel, weise ihnen WordPress-Seiten zu und greife auf jede dieser Seiten anhand ihres individuellen Seitenschlüssels zu."

#. Author of the plugin
#: page-keys.php
msgid "Thorsten Frommen"
msgstr "Thorsten Frommen"

#. Author URI of the plugin
#: page-keys.php
msgid "https://tfrommen.de"
msgstr "https://tfrommen.de"

#: inc/ListTable.php:55
msgid "Page Key"
msgstr "Seitenschlüssel"

#: inc/ListTable.php:56
msgid "Page"
msgstr "Seite"

#: inc/ListTable.php:203
msgid "For each page key, please select a page."
msgstr "Wähle für jeden Seitenschlüssel eine Seite aus."

#: inc/ListTable.php:266
msgid "Edit"
msgstr "Bearbeiten"

#: inc/ListTable.php:268
msgid "Edit this item"
msgstr "Element bearbeiten"

#: inc/ListTable.php:276
msgid "Delete Permanently"
msgstr "Endgültig löschen"

#: inc/ListTable.php:278
msgid "Delete this item permanently"
msgstr "Element endgültig löschen"

#: inc/ListTable.php:358
msgid "No page keys found."
msgstr "Keine Seitenschlüssel gefunden."

#: inc/Models/Script.php:95
msgid "Do you really want to delete this page key?"
msgstr "Willst du diesen Seitenschlüssel wirklich löschen?"

#: inc/Models/Script.php:96
msgid "There are unsaved changes. Do you really want to leave?"
msgstr "Nicht alle Änderungen wurden gespeichert. Willst du die Seite wirklich verlassen?"

#. translators: 1: page key, 2: page ID.
#: inc/Models/SettingsErrors/DuplicatePageKey.php:25
#, php-format
msgctxt "Settings error message"
msgid "Cannot map page key \"%1$s\" to page ID %2$d! Page key already set."
msgstr "Seitenschlüssel \"%1$s\" konnte Seite mit ID %2$d nicht zugewiesen werden! Seitenschlüssel existiert bereits."

#: inc/Models/SettingsErrors/InvalidNonce.php:21
msgctxt "Settings error message"
msgid "Nonce invalid!"
msgstr "Nonce ungültig!"

#. translators: 1: page key.
#: inc/Models/SettingsErrors/InvalidPageKey.php:24
#, php-format
msgctxt "Settings error message"
msgid "Page key \"%s\" invalid!"
msgstr "Seitenschlüssel \"%s\" ungültig!"

#: inc/Models/SettingsErrors/MissingPageKey.php:21
msgctxt "Settings error"
msgid "No page key given!"
msgstr "Kein Seitenschlüssel angegeben!"

#: inc/Models/SettingsErrors/NoPermissionToEdit.php:21
msgctxt "Settings error message"
msgid "You don't have permission to edit page keys."
msgstr "Du hast nicht die nötige Berechtigung, um Seitenschlüssel zu bearbeiten!"

#. translators: 1: page key.
#: inc/Models/SettingsErrors/PageKeyDeleted.php:24
#, php-format
msgctxt "Settings error message"
msgid "Page key \"%s\" permanently deleted."
msgstr "Seitenschlüssel \"%s\" endgültig gelöscht."

#. translators: 1: <strong>, 2: </strong>.
#: inc/Views/AdminNotice.php:63
#, php-format
msgid "%1$sImportant:%2$s Not all registered page keys have a page assigned."
msgstr "%1$sWichtig:%2$s Nicht allen registrierten Seitenschlüsseln wurde eine Seite zugewiesen."

#: inc/Views/AdminNotice.php:74
msgctxt "Link text in admin notice"
msgid "Assign pages now."
msgstr "Seiten jetzt zuweisen."

